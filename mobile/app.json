{
  "expo": {
    "name": "Prumo",
    "slug": "prumo",
    "scheme": "prumo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.gaewnt.prumo"
    },
    "android": {
      "package": "com.gaewnt.prumo",
      "adaptiveIcon": {
        "backgroundColor": "#17161A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "userInterfaceStyle": "automatic",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "expo-quick-actions",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Prumo usa Face ID pra proteger o acesso ao app."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Prumo usa o microfone pra você lançar despesas por voz.",
          "speechRecognitionPermission": "O Prumo usa o reconhecimento de voz pra entender o que você falou.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#2F455C"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/ibm-plex-sans/400Regular/IBMPlexSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans/500Medium/IBMPlexSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans/600SemiBold/IBMPlexSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/archivo/700Bold/Archivo_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "HojeWidget",
              "label": "Prumo — Hoje",
              "description": "O que vence ou está programado pra hoje, direto na tela inicial.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "vertical",
              "previewImage": "./assets/widget-preview/hoje.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withCopilotoAccessibility"
    ]
  }
}
